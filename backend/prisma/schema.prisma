// Prisma Schema – EduMarket
// This file will be expanded in Phase 2 (Database) with all entities.
// For now it only provides the generator/datasource so the client can be generated.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Public Flutter Web origin used in canonical URLs and sitemap links.
APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://edumarket_user:CHANGE_ME@localhost:5432/edumarket_dev?schema=public

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Flutter Web dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
# Production: set only explicit HTTPS Flutter Web origins, for example:
# CORS_ORIGINS=https://app.example.edu

# ── Session / Cookie ─────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE
COOKIE_SECURE=false          # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=Lax         # Lax for dev, Strict or None+Secure for production
# In production the backend forces Secure cookies even if COOKIE_SECURE is false.
# Set TRUST_PROXY=true only when one known reverse proxy terminates HTTPS before Express.
TRUST_PROXY=false

# ── VNPay Sandbox ─────────────────────────────────────────────────────────────
# Obtain Sandbox-only values from the VNPay merchant portal. Never commit real values.
VNPAY_TMN_CODE=CHANGEME
VNPAY_HASH_SECRET=CHANGEME
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/payments/vnpay/return

# ── File storage ─────────────────────────────────────────────────────────────
# Absolute path to directory where private course files are stored.
# Must NOT be inside the public/static web directory.
PRIVATE_STORAGE_PATH=./private_storage
MAX_FILE_SIZE_MB=100
# Optional path to a Unicode font used when rendering certificate PDFs.
# Leave empty to use the server default font; set an absolute deployment path when needed.
CERTIFICATE_FONT_PATH=
